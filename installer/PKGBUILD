# Maintainer: Sailer Developers <https://github.com/SidharthArya/sailer>
pkgname=sailer
pkgver=0.0.1
pkgrel=1
pkgdesc="A Wayland compositor written in Zig, built on wlroots"
arch=('x86_64' 'aarch64')
url="https://github.com/SidharthArya/sailer"
license=('MIT')
depends=('wlroots0.19' 'libxkbcommon' 'pixman' 'freetype2' 'dbus' 'python-yaml')
makedepends=('zig' 'wayland-protocols')
source=("$pkgname-$pkgver.tar.gz::https://github.com/SidharthArya/sailer/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP') # Update with actual sum when releasing

build() {
  cd "$pkgname-$pkgver"
  zig build -Doptimize=ReleaseSafe
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 zig-out/bin/sailer "$pkgdir/usr/bin/sailer"
  install -Dm755 zig-out/bin/sailer-mcp "$pkgdir/usr/bin/sailer-mcp"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
